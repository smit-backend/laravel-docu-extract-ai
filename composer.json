    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "smit-backend",
            "homepage": "https://github.com/smit-backend"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "SmitBackend\\DocuMatrix\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmitBackend\\DocuMatrix\\PackageServiceProvider"
            ]
        }
    }
}